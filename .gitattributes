* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.docx binary
*.pptx binary
*.pdf binary
*.png binary
# Preserve Matplotlib vector exports, including generated path whitespace.
/docs/presentation_20261103/*.svg -text whitespace=-blank-at-eol,cr-at-eol
# Preserve original benchmark files byte for byte, including their newlines.
/data/raw/** -text

# Preserve frozen experiment artifacts and receipt hashes across clones.
/experiments/007_macro_inference/** -text whitespace=cr-at-eol
/experiments/008_negation_consistency/** -text whitespace=cr-at-eol
/experiments/009_small_search/** -text whitespace=cr-at-eol
/experiments/010_semantic_search/** -text whitespace=cr-at-eol
/experiments/011_server_search/** -text whitespace=cr-at-eol
/experiments/012_server_replication/** -text whitespace=cr-at-eol
/experiments/013_binary_bilingual/** -text whitespace=cr-at-eol
/experiments/014_semantic_binary/** -text whitespace=cr-at-eol
/experiments/015_controlled_comparison/** -text whitespace=cr-at-eol
/experiments/server_summary/** -text whitespace=cr-at-eol

# V15 freezes also record source and test bytes.
/scripts/audit_controlled_v15*.py -text whitespace=cr-at-eol
/src/ab_factcheck/controlled_v15*.py -text whitespace=cr-at-eol
/tests/test_controlled_v15*.py -text whitespace=cr-at-eol
