* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.docx binary
# Preserve original benchmark files byte for byte, including their newlines.
/data/raw/** -text

# Preserve frozen experiment artifacts and receipt hashes across clones.
/experiments/007_macro_inference/** -text whitespace=cr-at-eol
/experiments/008_negation_consistency/** -text whitespace=cr-at-eol
/experiments/009_small_search/** -text whitespace=cr-at-eol
/experiments/010_semantic_search/** -text whitespace=cr-at-eol
/experiments/011_server_search/** -text whitespace=cr-at-eol
/experiments/012_server_replication/** -text whitespace=cr-at-eol
/experiments/013_binary_bilingual/** -text whitespace=cr-at-eol
/experiments/014_semantic_binary/** -text whitespace=cr-at-eol
/experiments/server_summary/** -text whitespace=cr-at-eol

# Preserve 27B experiment freezes, receipts and audited source hashes.
/experiments/016_finetune_27b/** -text whitespace=cr-at-eol
/scripts/*finetune*.py -text whitespace=cr-at-eol
/src/ab_factcheck/finetune27b*.py -text whitespace=cr-at-eol
/tests/test_finetune27b*.py -text whitespace=cr-at-eol

# Preserve V17/V18 freezes, review records and runtime source hashes.
/experiments/017_unified_comparison/** -text whitespace=cr-at-eol
/experiments/018_fusion/** -text whitespace=cr-at-eol
/scripts/*unified_v17*.py -text whitespace=cr-at-eol
/scripts/*fusion_v18*.py -text whitespace=cr-at-eol
/src/ab_factcheck/unified_v17.py -text whitespace=cr-at-eol
/src/ab_factcheck/fusion_v18*.py -text whitespace=cr-at-eol
/tests/test_unified_v17.py -text whitespace=cr-at-eol
/tests/test_fusion_v18*.py -text whitespace=cr-at-eol
# The audited Windows CSV contains CRCRLF; retain its original hash.
/experiments/017_unified_comparison/results/predictions.csv -text whitespace=-blank-at-eol,cr-at-eol
/experiments/018_fusion/**/*.csv -text whitespace=-blank-at-eol,cr-at-eol
# Keep published source bytes, including their original harmless whitespace.
/src/ab_factcheck/fusion_v18_training.py -text whitespace=-blank-at-eof,cr-at-eol
/scripts/summarize_fusion_v18_quick24.py -text whitespace=-blank-at-eol,cr-at-eol
